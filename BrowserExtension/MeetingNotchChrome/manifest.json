{
  "manifest_version": 3,
  "name": "MeetingNotch for Google Meet",
  "description": "Captures only the Google Meet tab explicitly selected by the user for MeetingNotch.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "offscreen",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bu Google Meet sekmesini MeetingNotch'a bağla",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
