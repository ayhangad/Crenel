---
// The app icon's glyph: six lamps drawing a crenel smile. They light one by one when the
// mark scrolls into view (`.mark.lit`).
interface Props { size?: number; class?: string }
const { size = 120, class: cls = '' } = Astro.props;
const lamps = [
  { x: 59, y: 0, o: 0.7, d: 2 }, { x: 0, y: 119, o: 0.76, d: 0 }, { x: 118, y: 178, o: 0.5, d: 4 },
  { x: 236, y: 178, o: 0.65, d: 6 }, { x: 295, y: 0, o: 0.56, d: 8 }, { x: 354, y: 119, o: 0.95, d: 10, h: true },
];
---
<div class={`mark ${cls}`} style={`--size:${size}px`}>
  <svg viewBox="0 0 472 296" width={size} aria-hidden="true">
    <defs>
      <radialGradient id="ml" cx="50%" cy="46%" r="78%"><stop offset="0" stop-color="#3BFFE8" /><stop offset=".38" stop-color="#05F0D2" /><stop offset="1" stop-color="#00A891" /></radialGradient>
      <radialGradient id="mh" cx="50%" cy="46%" r="78%"><stop offset="0" stop-color="#8AFFFF" /><stop offset=".38" stop-color="#0CF6F6" /><stop offset="1" stop-color="#00AFC0" /></radialGradient>
    </defs>
    {lamps.map((l) => (
      <rect x={l.x} y={l.y} width="118" height="118" fill={l.h ? 'url(#mh)' : 'url(#ml)'} style={`--o:${l.o};--d:${l.d * 70}ms`} />
    ))}
  </svg>
</div>
