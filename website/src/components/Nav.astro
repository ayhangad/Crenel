---
import AppleLogo from './AppleLogo.astro';
import GitHubLogo from './GitHubLogo.astro';
import LiveNotch from './LiveNotch.astro';
import { LATEST, REPO } from '../lib/site';
const home = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const at = (hash: string) => (home ? hash : `/${hash}`);
---
<!-- Fixed, and laid out like the macOS menu bar: the app and its menus on the left, the
     notch in the middle, status items on the right. -->
<header class="nav" id="nav">
  <!-- Progressive blur: stronger at the top edge, gone a little below the bar. -->
  <div class="nav-blur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap">
    <nav class="left" aria-label="Main">
      <a class="brand" href="/" aria-label="Crenel home"><img src="/media/app-icon.png" alt="" width="28" height="28" />Crenel</a>
      <a class="hide-mid" href={at('#features')}>Features</a>
      <a class="hide-mid" href={at('#privacy')}>Privacy</a>
      <a class="hide-mid" href="/releases">Releases</a>
    </nav>
    <div class="right">
      <a class="key glass sm hide-sm" href={REPO} aria-label="Crenel on GitHub"><GitHubLogo size={16} />GitHub</a>
      <a class="key black sm" href={LATEST}><AppleLogo size={15} />Download</a>
    </div>
  </div>
  <LiveNotch />
</header>
<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
