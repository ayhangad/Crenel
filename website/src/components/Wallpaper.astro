---
// The promo film's living wallpaper (promo/src/Promo.tsx, FIELDS): the app's teal, a blue
// beside it and only a touch of amber, blurred and drifting slowly.
const FIELDS = [
  // Placed for the hero: colour behind the headline, the strongest teal at the left edge,
  // blue through the middle, a touch of amber low on the left.
  { c: '#c8fbf2', x: 50, y: 8, w: 80, h: 40, r: -18, o: 0.9 },
  { c: '#14f0d4', x: 12, y: 38, w: 40, h: 60, r: -20, o: 0.85 },
  { c: '#22c7d8', x: 30, y: 42, w: 30, h: 70, r: -38, o: 0.75 },
  { c: '#2f8cf0', x: 52, y: 36, w: 22, h: 70, r: -42, o: 0.6 },
  { c: '#5b6cf2', x: 66, y: 34, w: 24, h: 66, r: -46, o: 0.45 },
  { c: '#a9d8f7', x: 84, y: 40, w: 40, h: 70, r: -48, o: 0.75 },
  { c: '#ffad33', x: 6, y: 72, w: 16, h: 18, r: -20, o: 0.4 },
];
---
<div class="wallpaper" aria-hidden="true">
  {FIELDS.map((b, i) => (
    <span
      class="blob"
      style={`left:${b.x}%;top:${b.y}%;width:${b.w}vw;height:${b.h}vw;--r:${b.r}deg;--d:${-i * 3.7}s;opacity:${b.o};background:radial-gradient(closest-side, ${b.c} 0%, ${b.c}00 100%)`}
    />
  ))}
  <svg class="grain"><filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" /></filter><rect width="100%" height="100%" filter="url(#grain)" /></svg>
</div>
