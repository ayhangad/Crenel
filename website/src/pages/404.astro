---
import Base from '../layouts/Base.astro';
import Seg from '../components/Seg.astro';
---
<Base title="Not found · Crenel">
  <main>
    <section class="hero on-paper" style="min-height: 80vh; padding-top: 200px">
      <div class="wrap">
        <div style="display:inline-grid;place-items:center;padding:22px 30px;border-radius:22px;background:#000;color:var(--ink-1)"><Seg text="404" h={56} /></div>
        <h1 class="h2" style="margin-top: 36px">Nothing lights up here.</h1>
        <p class="lede" style="margin: 16px auto 0">The page you're looking for isn't on this site.</p>
        <div class="cta-row"><a class="key black lg" href="/">Back to Crenel</a></div>
      </div>
    </section>
  </main>
</Base>
