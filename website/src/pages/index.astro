---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Icon from '../components/Icon.astro';
import Lamp from '../components/Lamp.astro';
import Seg from '../components/Seg.astro';
import Mark from '../components/Mark.astro';
import AppleLogo from '../components/AppleLogo.astro';
import { LATEST_DMG, REPO, REQUIREMENTS, X_HANDLE, X_URL } from '../lib/site';
import { getReleases } from '../lib/releases';

const releases = await getReleases();
const current = releases.find((r) => r.latest) ?? releases[0];

const sizes = [
  { key: 'closed', n: '1', name: 'Closed', text: 'One thing on each side of the camera: the next meeting and the minutes until it starts.', src: '/media/ill-meeting.webp', alt: 'Closed notch: Design review in 8 minutes' },
  { key: 'strip', n: '2', name: 'Strip', text: 'A single line drops under it when something needs you: a call starting, notes ready.', src: '/media/ill-ready.webp', alt: 'A strip under the notch: notes and 3 action items are ready' },
  { key: 'open', n: '3', name: 'Open', text: 'Hover, and it opens into a panel: your day, a recording, your tasks.', src: '/media/ill-today.webp', alt: 'The open notch: next meeting gauge, Record and Join, timeline and agenda' },
];

const features = [
  {
    id: 'calendar', lamp: 'g', tag: 'Calendar', title: "Always know what's next.",
    text: "Your next event and the time to it, or how long is left in the one you're in. Crenel reads Apple Calendar, so iCloud, Google and Exchange all work.",
    points: [['g', 'A Join key appears when the call starts.'], ['a', 'Invites waiting for your answer are marked.'], ['w', 'The whole day on one ruler, with a needle for now.']],
    shots: [['/media/ill-today.webp', 'Today in the open notch']],
  },
  {
    id: 'dictation', lamp: 'r', tag: 'Dictation', title: 'Hold fn and talk.',
    text: 'The words go wherever your cursor is. Speech becomes text on your Mac, and the audio is never saved.',
    points: [['w', 'Long dictation grows into a live view as you speak.'], ['w', 'Undo takes it back if it landed in the wrong place.'], ['g', 'Say "add task" and it becomes a task instead.']],
    shots: [['/media/ill-dictation.webp', 'Holding fn: the notch listens and shows the words live'], ['/media/ill-inserted.webp', 'The words were inserted where the cursor was']],
  },
  {
    id: 'notes', lamp: 'r', tag: 'Meeting notes', title: 'Notes write themselves.',
    text: "When a Zoom or Google Meet call starts, Crenel asks once whether to record it. Afterwards you get a transcript with speakers, a summary, what was decided and what's on you.",
    points: [['r', "Records the call and your mic, only while you're unmuted."], ['g', 'One click adds an action item to your tasks.'], ['w', 'Export as Markdown, PDF or plain text.']],
    shots: [['/media/ill-call.webp', 'A Zoom call starts and Crenel asks whether to record it'], ['/media/ill-recording.webp', 'Recording: elapsed time, waveform and levels'], ['/media/ill-ready.webp', 'Notes and 3 action items are ready']],
  },
  {
    id: 'tasks', lamp: 'a', tag: 'Tasks', title: 'Type one line.',
    text: '"Call mom tomorrow 3pm", "every Monday", "urgent". Crenel understands it as you write. Tasks live in a Crenel list in Apple Reminders, so they follow you to your iPhone and Watch.',
    points: [['a', 'Due times count down in the list.'], ['g', 'Synced with Apple Reminders.']],
    shots: [['/media/ill-tasks.webp', 'Tasks in the open notch']],
  },
];

const details = [
  { icon: 'video', tone: 'g', title: 'Join with one key', text: 'When a call starts, the notch shows a Join key. Press it and you are in.' },
  { icon: 'repeat', tone: 'w', title: 'Undo dictation', text: 'Wrong words in the wrong place? Undo takes them back for a few seconds after they land.' },
  { icon: 'mic', tone: 'r', title: 'Records only when you talk', text: 'Your mic is recorded while you are unmuted. Muted, nothing of yours is kept.' },
  { icon: 'transcript', tone: 'w', title: 'Markdown, PDF or text', text: 'Take the notes anywhere: copy them, or export a clean PDF to share.' },
  { icon: 'bell', tone: 'a', title: 'Invites, marked', text: 'Events still waiting for your answer get an amber mark, so nothing slips.' },
  { icon: 'archive', tone: 'g', title: 'Updates wait for you', text: 'Crenel updates itself, and never while you are on a call.' },
];
const SOLID = new Set(['video', 'mic', 'transcript', 'bell', 'archive']);

const faqs = [
  { q: 'Is Crenel free?', a: 'Yes. Crenel is free and open source under the MIT license. Every line is on GitHub.' },
  { q: 'Which Macs does it run on?', a: 'Any Mac on macOS 26 or later, Apple silicon or Intel. It is signed and notarized by Apple.' },
  { q: 'My Mac has no notch. Does it work?', a: 'Yes. On a display without a notch, Crenel draws its own at the top of the screen, external displays included.' },
  { q: 'Does anything leave my Mac?', a: "Not unless you choose a provider. Apple Speech transcribes the combined recording locally. Choosing ElevenLabs or Deepgram sends that provider the audio. For notes and tasks, Apple’s model processes the transcript locally. Choosing OpenAI sends the text to OpenAI. Choosing Anthropic or Claude Code sends it to Anthropic, including when Claude Code uses your existing sign-in. Dictation is transcribed on your Mac. If dictation clean-up uses OpenAI, Anthropic or Claude Code, the dictated text goes to that provider." },
  { q: 'Do I need an account?', a: 'No. There is nothing to sign up for, and there are no analytics.' },
  { q: 'Which calls can it record?', a: 'Anything your Mac plays. Zoom and Google Meet calls are noticed on their own; for Slack, Teams, FaceTime or anything else, press Record. Nothing to install in the browser.' },
  { q: 'Who is responsible for recording a call?', a: 'You are. Crenel is a local tool, like a recorder on your desk: it records what your Mac plays and your mic, and keeps your mic out while you are muted in the call. It does not notify anyone on the call. Whether you may record, and asking the others, is up to you and the law where you are.' },
];
---
<Base>
  <main>
    <!-- Hero. -->
    <section class="hero">
      <div class="notch-hint" aria-hidden="true">
        <svg class="cursor" viewBox="0 0 22 32"><path d="M4 3 L4 25 L9.2 20.2 L12.6 28.2 L16 26.7 L12.7 18.9 L19.6 18.9 Z" fill="#000" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" /></svg>
        Hover the notch
      </div>
      <div class="wrap">
        <a class="pill reveal" href="/releases"><Lamp on="g" />{current ? `Crenel ${current.version} is here` : 'New release'}<Icon id="i-arrow-right" size={12} /></a>
        <h1 class="display reveal">Your Mac's notch,<br /><span class="lit-word">at work.</span></h1>
        <p class="lede reveal">Calendar, dictation, tasks and meeting notes, right beside the camera. Open source, with on-device transcription and notes.</p>
        <div class="cta-row reveal">
          <a class="key black lg" href={LATEST_DMG}><AppleLogo size={17} />Download for Mac</a>
          <a class="key glass lg" href="#features">See how it works<Icon id="i-chevron-down" size={14} /></a>
        </div>
        <p class="meta reveal">{REQUIREMENTS} · Free</p>
      </div>

      <!-- One notch, three sizes: the same frame, the notch grows. -->
      <div class="sizes wrap reveal" id="sizes">
        <div class="sizes-tabs" role="tablist" aria-label="Notch sizes">
          {sizes.map((s, i) => (
            <button class:list={['size-tab', { on: i === 0 }]} role="tab" id={`size-tab-${s.key}`} aria-controls={`size-panel-${s.key}`} tabindex={i === 0 ? 0 : -1} aria-selected={i === 0 ? 'true' : 'false'} data-size={s.key} type="button">
              <span class="row"><Seg text={s.n} h={15} /><b>{s.name}</b></span>
              <span class="text">{s.text}</span>
              <i class="progress"></i>
            </button>
          ))}
        </div>
        <div class="sizes-frame">
          {sizes.map((s, i) => (
            <figure class:list={['frame', 'layered', { on: i === 0 }]} data-size={s.key}
              id={`size-panel-${s.key}`} role="tabpanel" aria-labelledby={`size-tab-${s.key}`}
              aria-hidden={i !== 0} tabindex={i === 0 ? 0 : -1}>
              <img src={s.src} alt={s.alt} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Features: words scroll, the picture stays. -->
    <section class="section" id="features">
      <div class="wrap">
        <div class="section-head center reveal">
          <span class="tag"><Lamp on="g" />Features</span>
          <h2 class="h2">Everything happens<br />next to the camera.</h2>
        </div>
        <div class="story">
          <div class="story-steps">
            {features.map((f, i) => (
              <article class:list={['step', { on: i === 0 }]} data-step={i}>
                <span class="tag"><Lamp on={f.lamp as 'g'} />{f.tag}</span>
                <h3 class="h2">{f.title}</h3>
                <p class="lede">{f.text}</p>
                <ul class="points">
                  {f.points.map(([l, t]) => <li><Lamp on={l as 'g'} /><span>{t}</span></li>)}
                </ul>
                <div class="step-shot"><Frame src={f.shots[0][0]} alt={f.shots[0][1]} /></div>
              </article>
            ))}
          </div>
          <div class="story-stage" aria-hidden="true">
            <div class="sticky">
              <div class="stack">
                {features.map((f, i) => f.shots.map(([src], j) => (
                  <figure class:list={['frame', 'layered', { on: i === 0 && j === 0 }]} data-step={i} data-shot={j}>
                    <img src={src} alt="" width="1600" height="1000" loading="lazy" />
                  </figure>
                )))}
              </div>
              <div class="story-dots">
                {features.map((f, i) => <span class:list={['dot', { on: i === 0 }]} data-step={i}><Lamp on={i === 0 ? 'w' : undefined} />{f.tag}</span>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The desktop window. -->
    <section class="section tight">
      <div class="wrap">
        <div class="section-head center reveal">
          <span class="tag"><Lamp on="w" />Desktop</span>
          <h2 class="h2">And a window when you want one.</h2>
          <p class="lede">Everything in the notch also opens in a full window: your day at a glance, every meeting, tasks, dictation history and settings.</p>
        </div>
        <div class="reveal wide-shot"><Frame src="/media/ill-window.webp" alt="The Crenel desktop window, Today page, under the notch" /></div>
      </div>
    </section>

    <!-- Small things. -->
    <section class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="tag"><Lamp on="a" />Details</span>
          <h2 class="h2">The small things, done.</h2>
          <p class="lede">Point at one. It lights up the way it does in the notch.</p>
        </div>
        <div class="details">
          {details.map((d) => (
            <article class={`detail reveal tone-${d.tone}`}>
              <span class="tt">
                <svg class="off" viewBox="0 0 16 16" width="18" height="18"><use href={`#i-${d.icon}`} /></svg>
                <svg class="lit" viewBox="0 0 16 16" width="18" height="18"><use href={`#${SOLID.has(d.icon) ? 'f' : 'i'}-${d.icon}`} /></svg>
              </span>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Privacy: one instrument panel. -->
    <section class="section" id="privacy">
      <div class="wrap">
        <div class="privacy reveal">
          <div class="privacy-head">
            <span class="tag"><Lamp on="g" />Privacy</span>
            <h2 class="h2">Private by design.</h2>
            <p class="lede">Crenel is a local tool. It records your Mac’s audio and your mic, keeps your mic out while you are muted, and stores everything on your Mac. You choose where audio is transcribed and where the transcript is summarized. What you record, and who you tell, is yours to decide.</p>
          </div>
          <div class="meters">
            <div class="meter"><Seg text="0" h={44} /><b>accounts</b><span>Nothing to sign up for.</span></div>
            <div class="meter"><Seg text="0" h={44} /><b>trackers</b><span>No analytics, no tracking SDK.</span></div>
            <div class="meter"><Seg text="0" h={44} /><b>audio kept</b><span>Dictation audio is never saved.</span></div>
          </div>
          <div class="privacy-grid">
            <div><h3><Lamp on="g" />On your Mac</h3><p>Recordings, transcripts, notes and tasks are stored on your Mac.</p></div>
            <div><h3><Lamp on="g" />Your providers</h3><p>Apple’s models run on your Mac. ElevenLabs or Deepgram can transcribe audio. OpenAI or Anthropic can process text. Claude Code sends text to Anthropic using your sign-in.</p></div>
            <div><h3><Lamp on="g" />Open source</h3><p>Every line is on <a href={REPO}>GitHub</a>, under the MIT license. Read it, build it, change it.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions. -->
    <section class="section">
      <div class="wrap faq">
        <div class="section-head reveal">
          <span class="tag"><Lamp on="w" />Questions</span>
          <h2 class="h2">Before you ask.</h2>
          <p class="lede" style="font-size: 17px">Something else? Ask me on X, <a href={X_URL}>{X_HANDLE}</a>.</p>
        </div>
        <div class="reveal">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<Icon id="i-plus" size={14} /></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Last call. -->
    <section class="final">
      <div class="wrap">
        <div class="final-panel reveal">
          <Mark size={150} class="final-mark" />
          <h2 class="h2">Put your notch to work.</h2>
          <p class="lede">Free, open source, and a minute to set up.</p>
          <div class="cta-row">
            <a class="key light lg" href={LATEST_DMG}><AppleLogo size={17} />Download for Mac</a>
            <a class="key dark lg" href="/releases">What's new<Icon id="i-arrow-right" size={14} /></a>
          </div>
          <p class="meta">{REQUIREMENTS}</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Three sizes: tabs switch the frame, and advance on their own until one is clicked.
    const root = document.getElementById('sizes');
    if (root) {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('.size-tab')];
      const frames = [...root.querySelectorAll<HTMLElement>('.sizes-frame .frame')];
      let i = 0, timer = 0, auto = !reduced, visible = false;
      const show = (n: number) => {
        i = n;
        tabs.forEach((t, k) => {
          t.classList.toggle('on', k === n);
          t.setAttribute('aria-selected', String(k === n));
          t.tabIndex = k === n ? 0 : -1;
          // Restart the progress bar on the active tab.
          const bar = t.querySelector('.progress');
          bar?.replaceWith(Object.assign(document.createElement('i'), { className: 'progress' }));
        });
        frames.forEach((f, k) => {
          f.classList.toggle('on', k === n);
          f.setAttribute('aria-hidden', String(k !== n));
          f.tabIndex = k === n ? 0 : -1;
        });
        root.classList.toggle('auto', auto);
      };
      const next = () => {
        clearTimeout(timer);
        if (!auto || !visible) return;
        timer = window.setTimeout(() => { show((i + 1) % tabs.length); next(); }, 4200);
      };
      const stopAuto = () => { auto = false; clearTimeout(timer); root.classList.remove('auto'); };
      root.addEventListener('focusin', stopAuto);
      tabs.forEach((tab, k) => {
        tab.addEventListener('click', () => { stopAuto(); show(k); });
        tab.addEventListener('keydown', (event) => {
          const target = {
            ArrowLeft: (k + tabs.length - 1) % tabs.length,
            ArrowRight: (k + 1) % tabs.length,
            Home: 0, End: tabs.length - 1,
          }[event.key];
          if (target === undefined) return;
          event.preventDefault();
          stopAuto();
          show(target);
          tabs[target].focus();
        });
      });
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) { show(i); next(); } else clearTimeout(timer);
      }, { threshold: 0.35 }).observe(root);
      show(0);
    }

    // ── Story: the step in the middle of the screen picks the picture.
    const steps = [...document.querySelectorAll<HTMLElement>('.step')];
    const shots = [...document.querySelectorAll<HTMLElement>('.story-stage .frame')];
    const dots = [...document.querySelectorAll<HTMLElement>('.story-dots .dot')];
    let active = -1, cycle = 0;
    const activate = (n: number) => {
      if (n === active) return;
      active = n;
      steps.forEach((s, k) => s.classList.toggle('on', k === n));
      dots.forEach((d, k) => { d.classList.toggle('on', k === n); d.querySelector('.lamp')?.classList.toggle('on-w', k === n); });
      const mine = shots.filter((s) => Number(s.dataset.step) === n);
      let j = 0;
      const paint = () => shots.forEach((s) => s.classList.toggle('on', s === mine[j]));
      paint();
      clearInterval(cycle);
      if (mine.length > 1 && !reduced) cycle = window.setInterval(() => { j = (j + 1) % mine.length; paint(); }, 2600);
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s));
    activate(0);
  </script>
</Base>
