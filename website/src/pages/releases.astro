---
// The release timeline, built from docs/releases/*.md (the notes Sparkle shows in the app).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Wallpaper from '../components/Wallpaper.astro';
import Seg from '../components/Seg.astro';
import Lamp from '../components/Lamp.astro';
import Icon from '../components/Icon.astro';
import AppleLogo from '../components/AppleLogo.astro';
import XLogo from '../components/XLogo.astro';
import { getReleases, formatDate } from '../lib/releases';
import { REPO, X_HANDLE, X_URL, dmgUrl, releaseUrl } from '../lib/site';

const releases = await Promise.all(
  (await getReleases()).map(async (r) => ({ ...r, Content: (await render(r.entry)).Content })),
);
---
<Base title="Releases · Crenel" description="Every Crenel release, newest first, with what changed.">
  <main>
    <section class="rel-hero on-paper">
      <Wallpaper soft />
      <div class="wrap">
        <span class="tag reveal"><Lamp on="g" />Releases</span>
        <h1 class="display reveal">What's new in Crenel.</h1>
        <p class="lede reveal">Every release, newest first. Crenel installs updates itself when you're not on a call, so you rarely need this page. It's here for the curious.</p>
      </div>
    </section>

    <section class="timeline on-paper">
      <div class="wrap">
        {releases.map((r) => (
          <article class="release reveal" id={`v${r.version}`}>
            <aside class="rail">
              <div class="rail-sticky">
                <a class="ver" href={`#v${r.version}`} aria-label={`Crenel ${r.version}`}><Seg text={r.version} h={34} /></a>
                <div class="when">
                  {r.latest ? <span class="state"><Lamp on="g" />Latest</span> : r.published ? <span class="state"><Lamp />Earlier</span> : <span class="state"><Lamp on="a" />Coming soon</span>}
                  {r.date && <time datetime={r.date.toISOString()}>{formatDate(r.date)}</time>}
                </div>
              </div>
            </aside>
            <div class="card on-dark">
              <div class="prose"><r.Content /></div>
              {r.published && (
                <div class="actions">
                  <span class="meta"><Lamp on="g" />Signed and notarized</span>
                  <span class="grow"></span>
                  <a class="key dark sm" href={releaseUrl(r.version)}>On GitHub<Icon id="i-link" size={13} /></a>
                  <a class="key light sm" href={dmgUrl(r.version)}><AppleLogo size={14} />Download {r.version}</a>
                </div>
              )}
            </div>
          </article>
        ))}
        <p class="rel-foot reveal">Something broken or missing? Tell me on X, <a href={X_URL}><XLogo size={13} />{X_HANDLE}</a>, or <a href={`${REPO}/issues`}>open an issue</a>.</p>
      </div>
    </section>
  </main>
</Base>

<style>
  .rel-hero { position: relative; padding: 160px 0 40px; overflow: hidden; isolation: isolate; }
  .rel-hero .wallpaper { z-index: -1; }
  .rel-hero .display { margin-top: 18px; font-size: clamp(42px, 6.4vw, 80px); max-width: 12ch; }
  .rel-hero .lede { margin-top: 20px; max-width: 34em; }

  .timeline { padding: 60px 0 140px; }
  .release { display: grid; grid-template-columns: 220px 1fr; gap: 40px; position: relative; }
  .release + .release { margin-top: 72px; }
  /* The rail is a ruler: ticks down the left edge, a lit tick at each release. */
  .rail { position: relative; }
  .rail::before { content: ''; position: absolute; top: 14px; bottom: -72px; left: 0; width: 6px; background: repeating-linear-gradient(180deg, rgba(0, 0, 0, .16) 0 1px, transparent 1px 12px); }
  .release:last-of-type .rail::before { bottom: 0; mask-image: linear-gradient(180deg, #000 60%, transparent); }
  .rail-sticky { position: sticky; top: 32px; padding-left: 26px; }
  .rail-sticky::before { content: ''; position: absolute; left: -2px; top: 14px; width: 18px; height: 2px; border-radius: 1px; background: var(--pen-1); }
  .ver { display: inline-block; color: var(--pen-1); text-decoration: none; }
  .ver :global(.segd svg) { filter: none; }
  .ver :global(.segd .g) { opacity: .06; }
  .when { display: grid; gap: 6px; margin-top: 14px; font-size: 14px; color: var(--pen-3); }
  .state { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--pen-2); }

  .card { border-radius: 24px; padding: 40px 44px 30px; background: #000; box-shadow: 0 40px 80px -40px rgba(0, 30, 50, .5); }
  .prose { color: var(--ink-2); font-size: 16px; line-height: 1.65; }
  .prose :global(h1) { font-size: 30px; line-height: 1.1; letter-spacing: -.03em; color: var(--ink-1); }
  .prose :global(h2) { margin-top: 32px; font-size: 20px; letter-spacing: -.015em; color: var(--ink-1); }
  .prose :global(h3) { margin-top: 24px; font-size: 17px; color: var(--ink-1); }
  .prose :global(p) { margin-top: 14px; max-width: 42em; }
  .prose :global(ul) { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 16px; }
  .prose :global(li) { position: relative; padding-left: 26px; max-width: 46em; }
  .prose :global(li)::before { content: ''; position: absolute; left: 2px; top: .68em; width: 8px; height: 4px; border-radius: 2px; background: radial-gradient(ellipse 70% 80% at 50% 45%, #b9fff3, #34e6cb 72%); box-shadow: 0 0 6px rgba(52, 230, 203, .65), 0 0 16px rgba(52, 230, 203, .2); }
  .prose :global(strong) { color: var(--ink-1); font-weight: 600; }
  .prose :global(a) { color: var(--ink-1); }
  .prose :global(code) { font: 500 .9em var(--font); padding: 2px 6px; border-radius: 5px; background: rgba(255, 255, 255, .07); color: var(--ink-1); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 36px; }
  .actions .meta { display: inline-flex; align-items: center; gap: 9px; font-size: 13.5px; }
  .actions .grow { flex: 1; }
  .rel-foot { margin-top: 80px; padding-left: 260px; color: var(--pen-3); font-size: 15.5px; }
  .rel-foot a { color: var(--pen-1); display: inline-flex; align-items: center; gap: 5px; }

  @media (max-width: 860px) {
    .release { grid-template-columns: 1fr; gap: 18px; }
    .rail::before, .rail-sticky::before { display: none; }
    .rail-sticky { position: static; padding-left: 0; display: flex; align-items: center; gap: 18px; }
    .when { margin-top: 0; }
    .card { padding: 30px 24px 24px; }
    .rel-foot { padding-left: 0; }
  }
</style>
